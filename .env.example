# Скопируйте этот файл в .env и заполните своими значениями.
# .env опционален: сервер читает обычные переменные окружения, .env — просто
# удобный способ задать их локально при разработке.

# OAuth-токен с доступом к Tracker API (обязательно).
# См. https://yandex.ru/support/tracker/ru/concepts/access
YANDEX_TRACKER_TOKEN=y0_...

# ID организации, отправляется в заголовке X-Org-ID (организации Яндекс 360).
# Нужно указать ровно одну из YANDEX_TRACKER_ORG_ID / YANDEX_TRACKER_CLOUD_ORG_ID.
YANDEX_TRACKER_ORG_ID=1234567

# ID организации, отправляется в заголовке X-Cloud-Org-ID (организации Yandex Cloud).
# YANDEX_TRACKER_CLOUD_ORG_ID=1234567

# Переопределяет базовый URL API (по умолчанию https://api.tracker.yandex.net).
# YANDEX_TRACKER_BASE_URL=https://api.tracker.yandex.net

# Какие тулы доступны клиенту: read-only (только чтение), read-write
# (чтение + изменения, без деструктивных/массовых операций — по умолчанию)
# или full (вообще без ограничений).
# YANDEX_TRACKER_TOOLS_MODE=read-write

# Список glob-паттернов через запятую (точное имя или имя с *), которым должно
# соответствовать имя тула, чтобы он зарегистрировался. По умолчанию:
# issue_*,queue*,board*,component_*,field_*,user*,worklog_*
# * снимает ограничение и включает все тулы, разрешённые режимом выше.
# YANDEX_TRACKER_TOOLS=issue_*,queue*,board*,component_*,field_*,user*,worklog_*
